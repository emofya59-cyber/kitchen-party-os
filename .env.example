# Frontend (Vite). Leave empty to run the offline demo with mock Lusaka data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge function secrets live in Supabase, NOT here. Set them with:
#   supabase secrets set XAI_API_KEY=xai-...            (required for plan-event)
#   supabase secrets set XAI_MODEL=grok-4.7             (optional)
#   supabase secrets set XAI_STRICT_SCHEMA=true         (optional: send strict json_schema)
#   supabase secrets set ELICATE_WEBHOOK_SECRET=...     (TODO(elicate): confirm signing scheme)
#   supabase secrets set ELICATE_API_BASE=... ELICATE_API_KEY=...   (TODO(elicate))

# Demo bridge key sent by the dashboard's Accept/Counter buttons to /api/bridge (owner's demo choice).
VITE_BRIDGE_KEY=lusaka2026

# Cloudflare Pages Function secrets (set in Pages project settings, NOT VITE_*):
#   SUPABASE_URL, SUPABASE_ANON_KEY (or SUPABASE_SERVICE_ROLE_KEY), optional BRIDGE_KEY
